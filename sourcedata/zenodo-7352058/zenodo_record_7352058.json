{"created": "2022-11-23T17:41:26.228795+00:00", "modified": "2022-11-24T14:26:53.949140+00:00", "id": 7352058, "conceptrecid": "7352057", "doi": "10.5281/zenodo.7352058", "conceptdoi": "10.5281/zenodo.7352057", "doi_url": "https://doi.org/10.5281/zenodo.7352058", "metadata": {"title": "Microelectrode register (MER) data from Deep Brain Stimulation (DBS) surgery in Parkinson's disease patients", "doi": "10.5281/zenodo.7352058", "publication_date": "2022-11-23", "description": "<p>MER data consist of brain signal in different depths when DBS surgery is being done. In each depth, a data file is created, with different duration depending on the depth, and up to three channels.</p>\n\n<p>Data come from 14 patients (9 males and 5 females), they are anonymized and labelled from P1 to P14. They correspond to patients in age 65.1 +- 5.6 years.</p>\n\n<p>Data are organized in STN-IN and STN-OUT (different depths in each folder), subthalamus-in, and subthalamus-out since the STN area is the target area when implanting a DBS. Classification in STN-IN and STN-OUT was made by the neurophysiologists and surgeons.</p>\n\n<p>Data were recorded for left and right lobes, 8 patients in left and right lobe, 1 patient in right lobe, and 5 patients in left lobe.</p>\n\n<p>The format is mat file (MATLAB file)</p>\n\n<p>Data sampling frequency is 12kHz.</p>\n\n<p>No filtering or data processing was made, they are directly obtained from the MER acquisition system.</p>\n\n<p>&nbsp;</p>", "access_right": "open", "creators": [{"name": "Rosado-Mu\u00f1oz, Alfredo", "affiliation": "University of Valencia", "orcid": "0000-0002-0429-0573"}, {"name": "Guerrero-Mart\u00ednez, Juan Francisco", "affiliation": "University of Valencia", "orcid": "0000-0001-6729-585X"}, {"name": "Gutierrez Mart\u00edn, Antonio", "affiliation": "La Fe University Hospital"}], "keywords": ["Microelectrode Register - MER", "Deep Brain Stimulation - DBS", "Parkinson disease"], "related_identifiers": [{"identifier": "10.1155/2017/1512504", "relation": "isSourceOf", "resource_type": "publication-article", "scheme": "doi"}], "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "7352057"}}]}}, "title": "Microelectrode register (MER) data from Deep Brain Stimulation (DBS) surgery in Parkinson's disease patients", "links": {"self": "https://zenodo.org/api/records/7352058", "self_html": "https://zenodo.org/records/7352058", "preview_html": "https://zenodo.org/records/7352058?preview=1", "doi": "https://doi.org/10.5281/zenodo.7352058", "self_doi": "https://doi.org/10.5281/zenodo.7352058", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.7352058", "reserve_doi": "https://zenodo.org/api/records/7352058/draft/pids/doi", "parent": "https://zenodo.org/api/records/7352057", "parent_html": "https://zenodo.org/records/7352057", "parent_doi": "https://doi.org/10.5281/zenodo.7352057", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.7352057", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:7352058/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:7352058/sequence/default", "files": "https://zenodo.org/api/records/7352058/files", "media_files": "https://zenodo.org/api/records/7352058/media-files", "archive": "https://zenodo.org/api/records/7352058/files-archive", "archive_media": "https://zenodo.org/api/records/7352058/media-files-archive", "latest": "https://zenodo.org/api/records/7352058/versions/latest", "latest_html": "https://zenodo.org/records/7352058/latest", "versions": "https://zenodo.org/api/records/7352058/versions", "draft": "https://zenodo.org/api/records/7352058/draft", "access_links": "https://zenodo.org/api/records/7352058/access/links", "access_grants": "https://zenodo.org/api/records/7352058/access/grants", "access_users": "https://zenodo.org/api/records/7352058/access/users", "access_request": "https://zenod